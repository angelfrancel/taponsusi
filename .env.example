# Copy this file to .env and fill in real values.

# PostgreSQL
DB_USERNAME=taponsusi
DB_PASSWORD=taponsusi

# JWT — generate a long random string for real use, never reuse this placeholder
JWT_SECRET=change-this-in-env-CHANGE-THIS-IN-ENV-1234567890
JWT_EXPIRATION_MS=86400000

# Facebook App — from developers.facebook.com/apps/<your-app-id>/settings/basic/
FACEBOOK_APP_SECRET=dev-placeholder-secret-CHANGE-IN-ENV
FACEBOOK_WEBHOOK_VERIFY_TOKEN=dev-placeholder-token-CHANGE-IN-ENV